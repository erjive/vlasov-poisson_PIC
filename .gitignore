# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directory and Makefile bookkeeping files
objs/
.config
.timestart
.timeend

# Jupyter checkpoints
.ipynb_checkpoints/
__pycache__/

# Videos de las animaciones: se regeneran con paper_runs/scripts/make_video.py
reproducir/videos/
paper_runs/videos/

# Salidas de las corridas. Todo lo que aparece en exe/ son directorios de
# resultados, salvo el ejecutable.
exe/*
!exe/VP_PIC

# El PDF se regenera con latexmk; se versiona solo la fuente
docs/**/*.pdf
!docs/introduccion/figuras/*.pdf
!docs/demo_eta/figuras/*.pdf
docs/**/*.aux
docs/**/*.log
docs/**/*.out
docs/**/*.toc
docs/**/*.fls
docs/**/*.fdb_latexmk
