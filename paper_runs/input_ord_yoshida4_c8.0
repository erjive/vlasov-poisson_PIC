# input_ord_yoshida4_c8.0

# Grid and time
dr               = 0.1          # grid spacing in r
Nrc              = 800          # cells in r used to lay out the particles
Npc              = 40           # cells in p_r used to lay out the particles
courant          = 8.0          # Courant factor for the time step
Nt               = 7500         # number of time steps

# Domain
rmin             = 0.0          # inner edge of the grid
rmax             = 20.0         # outer edge of the grid
rminc            = 1.0          # inner edge of the support of f
rmaxc            = 10.0         # outer edge of the support of f
pminc            = -0.6         # lower edge in p_r of the support of f
pmaxc            = 0.6          # upper edge in p_r of the support of f
Lfix             = 2.0          # angular momentum L0 of the delta(L-L0) distribution

# Particle bookkeeping
reduceparticles  = .false.      # discard particles that leave the domain
Nreduce          = 1000         # how often particles are discarded

# Output
time_output      = 20000        # cadence of the time series output
spatial_output   = 100          # cadence of the grid output, and of h_k
directory        = ord_yoshida4_c8.0 # output directory

# Initial distribution
a0               = 0.0001       # total mass of the distribution
r0               = 0.01         # center in r of the gaussian; for the action-angle states,
          # the fraction of the peak below which particles are dropped
p0               = 0.0          # center in p_r of the initial gaussian
sr               = 0.1          # width in r   (sigma_J for the action-angle states)
sp               = 0.1          # width in p_r (sigma_Q for the action-angle states)
state            = aa_quad      # aa, aa_halton, aa_quad or aa_random

# Test functions for the h_k modes
j1               = 0.0          # J3 of the first test function Phi_1
j2               = 0.15         # J3 of the second test function Phi_2
sj1              = 0.1          # width in J3 of Phi_1
sj2              = 0.05         # width in J3 of Phi_2
sq1              = 0.1          # width in Q3 of Phi_1
sq2              = 0.2          # width in Q3 of Phi_2

# Numerical methods
bsplineorder     = 1            # order of the particle shape function
integrator       = yoshida4     # euler, leapfrog, yoshida4, yoshida6 or analytic
spatialorder     = two          # order of the spatial discretization
forcetype        = bg           # bg (external background) or self
BGtype           = Isochrone    # null, sphere, Isochrone, iso, isotrun, nfw or burkert
autointeraction  = .false.      # solve the Poisson equation for the particles
output_format    = hdf5         # ascii, hdf5 or raw

# Output
field_output     = 1000000      # particle snapshot cadence (multiple of spatial_output)

# Physics
eps              = 0.0          # softening of the centrifugal term; 0 unless L0 -> 0
